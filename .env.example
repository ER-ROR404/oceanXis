# === OceanEmbed environment variables (placeholders only — no real secrets) ===
# Copy to .env and fill in real values. NEVER commit .env.

# --- Copernicus Marine Toolbox authentication (backend-only) ---
# Required for describe()/subset()/get(). Must remain server-side.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# --- Application ---
# Regime: local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Storage / data ---
DATA_ROOT=./data
RAW_DATA_DIR=${DATA_ROOT}/raw
PROCESSED_DATA_DIR=${DATA_ROOT}/processed
CACHE_DIR=${DATA_ROOT}/cache
DATASET_MANIFEST=${DATA_ROOT}/manifests/datasets.json

# --- Model ---
MODEL_PATH=./model-registry/models
MODEL_NAME=oceanembed-cnn
MODEL_VERSION=
CHECKPOINT_URI=

# --- Database (metadata + application state only) ---
# e.g. sqlite:///./data/oceanembed.db or postgresql+psycopg://user:pass@host:5432/oceanembed
DATABASE_URL=sqlite:///./data/oceanembed.db

# --- Frontend (dev) ---
VITE_API_BASE_URL=http://localhost:8000/api